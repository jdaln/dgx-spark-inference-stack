+        def _lane_route(self, method) -> bool:
+            """This image serves one hardened lane: only the routes in LANE_ROUTES exist.  Every other one (the
+            dashboard, settings, model management, updates, MCP, the Ollama, Responses and Anthropic APIs) is a 404,
+            before any key is read."""
+            if self.path.split("?")[0].rstrip("/") in LANE_ROUTES.get(method, ()):
+                return True
+            self._json(404, {"error": {"type": "not_found_error", "message": "not found"}})
+            return False
+
         def do_OPTIONS(self):
